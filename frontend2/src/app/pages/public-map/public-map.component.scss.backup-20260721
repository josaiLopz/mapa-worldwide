/* ========== FAB BUSCADOR ========== */
.fab-search {
  position: fixed;
  bottom: 24px;
  right: 20px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--teal-600);
  color: #fff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  z-index: 150;
  transition: background var(--t-fast), transform var(--t-fast), box-shadow var(--t-fast);
}

.fab-search:hover {
  background: var(--teal-700, var(--teal-600));
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,.2);
}

.fab-search:active {
  transform: scale(0.94);
}

.fab-search svg {
  width: 24px;
  height: 24px;
  transition: transform 0.25s ease;
}

/* Estado activo (buscador abierto): icono de cerrar */
.fab-search.active {
  background: var(--slate-700, #475569);
}

.fab-search.active svg {
  transform: rotate(90deg);
}

/* ========== ANIMACIÓN DEL HEADER (mostrar/ocultar) ========== */
.header {
  animation: header-slide-down 0.25s ease-out;
  transform-origin: top center;
}

@keyframes header-slide-down {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Cuando el header está oculto, el mapa ocupa toda la altura disponible */
.page.header-hidden {
  .map-area {
    height: 100dvh;
  }
}

/* ========== RESPONSIVE: ajustar posición del FAB en móvil ========== */
@media (max-width: 480px) {
  .fab-search {
    bottom: 16px;
    right: 16px;
    width: 22px;
    height: 22px;
  }

  .fab-search svg {
    width: 18px;
    height: 18px;
  }
}

/* ========== ACCESIBILIDAD ========== */
.fab-search:focus-visible {
  outline: 2px solid var(--teal-400);
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  .fab-search,
  .fab-search svg,
  .header {
    animation: none;
    transition: none;
  }
}
